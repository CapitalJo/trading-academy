# Copy this file to ".env" (same folder) and paste your Alpaca PAPER trading keys.
# Paper keys come from the Alpaca dashboard while the PAPER account is selected.
# NEVER share this file, commit it, or paste keys into the Academy or any chat.
ALPACA_API_KEY_ID=PKXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET_KEY=your_paper_secret_here
# Optional. Only the paper URL is accepted; anything else is refused.
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
